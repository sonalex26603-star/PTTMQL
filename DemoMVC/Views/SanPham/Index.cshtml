
@model IEnumerable<DemoMVC.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý sản phẩm</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm sản phẩm
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sp in Model)
            {
                <tr>
                    <td>@sp.Id</td>
                    <td>@sp.TenSanPham</td>
                    <td>@sp.Gia.ToString("N0") đ</td>
                    <td>@sp.SoLuong</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@sp.Id"
                           class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@sp.Id"
                           class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@sp.Id"
                           class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Chưa có sản phẩm nào. Hãy nhấn “Thêm sản phẩm” để bắt đầu.
        </div>
    }
</div>
